POSTGRES_DB=noogymsoftware
POSTGRES_USER=noogym
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_PORT=5432

API_PORT=3333
WEB_PORT=3000
DATABASE_URL=postgresql://noogym:change-this-db-password@postgres:5432/noogymsoftware?schema=public

AUTH_PROVIDER=local
JWT_SECRET=change-this-to-a-long-random-secret-with-at-least-32-chars
JWT_EXPIRES_IN=1d
PASSWORD_RESET_BASE_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_EXPOSE_TOKEN=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Noogym <noreply@noogym.com>"
CORS_ORIGINS=http://localhost:3000
NOOGYM_API_URL=http://localhost:3333
NEXT_PUBLIC_NOOGYM_API_URL=http://localhost:3333

RUN_MIGRATIONS=true
DATABASE_RETRY_DELAY_MS=2000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
