generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  MANAGER
  TRAINER
  RECEPTIONIST
  FINANCE
  NUTRITIONIST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  OVERDUE
  BLOCKED
  CANCELLED
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  OVERDUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MULTICAIXA
  PIX
  DIRECT_DEBIT
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AppointmentType {
  CLASS
  PERSONAL
  ASSESSMENT
  MEETING
  EVENT
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CheckInMethod {
  QR_CODE
  MANUAL
  BIOMETRIC
  APP
  NFC
}

enum MessageChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum MessageStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED
}

enum WorkoutLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum WorkoutStatus {
  ACTIVE
  PAUSED
  DRAFT
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  NOT_INFORMED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  REFUNDED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum SaleType {
  NORMAL
  QUOTE
  SUBSCRIPTION
  SERVICE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
  RETURN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum GymClassStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ClassEnrollmentStatus {
  RESERVED
  PRESENT
  ABSENT
  CANCELLED
  WAITLISTED
}

model Organization {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  email              String?
  phone              String?
  website            String?
  logoUrl            String?
  country            String?             @default("Angola")
  currency           String              @default("AOA")
  timezone           String              @default("Africa/Luanda")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  gyms               Gym[]
  users              User[]
  members            Member[]
  plans              Plan[]
  subscriptions      Subscription[]
  payments           Payment[]
  expenses           Expense[]
  workouts           Workout[]
  exercises          Exercise[]
  appointments       Appointment[]
  checkIns           CheckIn[]
  messages           Message[]
  integrations       Integration[]
  products           Product[]
  sales              Sale[]
  employees          Employee[]
  gymClasses         GymClass[]
  stockMovements     StockMovement[]
  planCategories     PlanCategory[]
  financeAccounts    FinanceAccount[]
  financeCategories  FinanceCategory[]
  cashSessions       CashSession[]
  cashClosings       CashClosing[]
  operationalSetting OperationalSetting?
}

model OperationalSetting {
  id             String       @id @default(uuid())
  organizationId String       @unique
  settings       Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Gym {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  slug           String
  email          String?
  phone          String?
  address        String?
  city           String?
  province       String?
  country        String?       @default("Angola")
  logoUrl        String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  members        Member[]
  users          UserGym[]
  rooms          Room[]
  appointments   Appointment[]
  checkIns       CheckIn[]
  products       Product[]
  sales          Sale[]
  employees      Employee[]
  gymClasses     GymClass[]
  plans          PlanGym[]
  cashSessions   CashSession[]
}

model User {
  id                          String        @id @default(uuid())
  organizationId              String
  name                        String
  email                       String        @unique
  phone                       String?
  passwordHash                String?
  refreshTokenHash            String?
  passwordResetTokenHash      String?
  passwordResetTokenExpiresAt DateTime?
  role                        UserRole      @default(ADMIN)
  status                      UserStatus    @default(ACTIVE)
  avatarUrl                   String?
  lastLoginAt                 DateTime?
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt
  organization                Organization  @relation(fields: [organizationId], references: [id])
  gyms                        UserGym[]
  createdWorkouts             Workout[]     @relation("WorkoutCreator")
  appointments                Appointment[] @relation("AppointmentProfessional")
  employeeProfile             Employee?
  sales                       Sale[]        @relation("SaleSeller")
  openedCashSessions          CashSession[] @relation("CashSessionOpenedBy")
  closedCashClosings          CashClosing[] @relation("CashClosingClosedBy")
}

model UserGym {
  id        String   @id @default(uuid())
  userId    String
  gymId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  gym       Gym      @relation(fields: [gymId], references: [id])

  @@unique([userId, gymId])
}

model Member {
  id                 String               @id @default(uuid())
  organizationId     String
  gymId              String?
  name               String
  email              String?
  phone              String?
  birthDate          DateTime?
  gender             Gender               @default(NOT_INFORMED)
  documentNumber     String?
  address            String?
  city               String?
  status             MemberStatus         @default(ACTIVE)
  avatarUrl          String?
  qrToken            String?              @unique
  qrTokenUpdatedAt   DateTime?
  emergencyName      String?
  emergencyPhone     String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  organization       Organization         @relation(fields: [organizationId], references: [id])
  gym                Gym?                 @relation(fields: [gymId], references: [id])
  subscriptions      Subscription[]
  payments           Payment[]
  checkIns           CheckIn[]
  appointments       Appointment[]
  assessments        PhysicalAssessment[]
  workoutAssignments WorkoutAssignment[]
  messages           MessageRecipient[]
  sales              Sale[]
  classEnrollments   ClassEnrollment[]

  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@unique([organizationId, documentNumber])
}

model Plan {
  id               String         @id @default(uuid())
  organizationId   String
  name             String
  description      String?
  category         String         @default("Geral")
  color            String?
  price            Decimal        @db.Decimal(12, 2)
  durationDays     Int
  status           PlanStatus     @default(ACTIVE)
  maxCheckIns      Int?
  includesClasses  Boolean        @default(true)
  includesWorkouts Boolean        @default(false)
  isPopular        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organization     Organization   @relation(fields: [organizationId], references: [id])
  subscriptions    Subscription[]
  saleItems        SaleItem[]
  gyms             PlanGym[]
}

model PlanGym {
  id        String   @id @default(uuid())
  planId    String
  gymId     String
  createdAt DateTime @default(now())
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([planId, gymId])
  @@index([gymId])
}

model PlanCategory {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  icon           String?
  description    String?
  color          String       @default("#B6FF00")
  status         PlanStatus   @default(ACTIVE)
  displayOrder   Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model Subscription {
  id              String             @id @default(uuid())
  organizationId  String
  memberId        String
  planId          String
  status          SubscriptionStatus @default(ACTIVE)
  startDate       DateTime
  endDate         DateTime
  nextBillingDate DateTime?
  autoRenew       Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  organization    Organization       @relation(fields: [organizationId], references: [id])
  member          Member             @relation(fields: [memberId], references: [id])
  plan            Plan               @relation(fields: [planId], references: [id])
  payments        Payment[]
}

model Payment {
  id                String        @id @default(uuid())
  organizationId    String
  memberId          String?
  subscriptionId    String?
  saleId            String?
  amount            Decimal       @db.Decimal(12, 2)
  grossAmount       Decimal?      @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(12, 2)
  lateFeeAmount     Decimal       @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal       @default(0) @db.Decimal(12, 2)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  dueDate           DateTime?
  reference         String?
  receiptNumber     String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  organization      Organization  @relation(fields: [organizationId], references: [id])
  member            Member?       @relation(fields: [memberId], references: [id])
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])
  sale              Sale?         @relation(fields: [saleId], references: [id])

  @@unique([organizationId, receiptNumber])
}

model Expense {
  id             String         @id @default(uuid())
  organizationId String
  category       String
  description    String
  amount         Decimal        @db.Decimal(12, 2)
  method         PaymentMethod?
  status         PaymentStatus  @default(PAID)
  paidAt         DateTime?
  dueDate        DateTime?
  supplier       String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
}

model FinanceAccount {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  bank           String?
  type           String       @default("Corrente")
  openingBalance Decimal      @default(0) @db.Decimal(12, 2)
  balance        Decimal      @default(0) @db.Decimal(12, 2)
  status         String       @default("ACTIVE")
  isDefault      Boolean      @default(false)
  color          String       @default("#B6FF00")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model FinanceCategory {
  id             String       @id @default(uuid())
  organizationId String
  kind           String
  name           String
  description    String?
  color          String       @default("#B6FF00")
  status         String       @default("ACTIVE")
  displayOrder   Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, kind, name])
  @@index([organizationId, kind, status])
}

model CashSession {
  id             String            @id @default(uuid())
  organizationId String
  gymId          String?
  openedById     String?
  status         CashSessionStatus @default(OPEN)
  openingAmount  Decimal           @default(0) @db.Decimal(12, 2)
  openedAt       DateTime          @default(now())
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id])
  gym            Gym?              @relation(fields: [gymId], references: [id])
  openedBy       User?             @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  closing        CashClosing?
  sales          Sale[]

  @@index([organizationId, status, openedAt])
  @@index([gymId, status])
}

model CashClosing {
  id                 String       @id @default(uuid())
  organizationId     String
  sessionId          String       @unique
  closedById         String?
  expectedCash       Decimal      @default(0) @db.Decimal(12, 2)
  actualCash         Decimal      @default(0) @db.Decimal(12, 2)
  expectedCard       Decimal      @default(0) @db.Decimal(12, 2)
  actualCard         Decimal      @default(0) @db.Decimal(12, 2)
  expectedTransfer   Decimal      @default(0) @db.Decimal(12, 2)
  actualTransfer     Decimal      @default(0) @db.Decimal(12, 2)
  expectedMulticaixa Decimal      @default(0) @db.Decimal(12, 2)
  actualMulticaixa   Decimal      @default(0) @db.Decimal(12, 2)
  expectedPix        Decimal      @default(0) @db.Decimal(12, 2)
  actualPix          Decimal      @default(0) @db.Decimal(12, 2)
  expectedOther      Decimal      @default(0) @db.Decimal(12, 2)
  actualOther        Decimal      @default(0) @db.Decimal(12, 2)
  expectedTotal      Decimal      @default(0) @db.Decimal(12, 2)
  actualTotal        Decimal      @default(0) @db.Decimal(12, 2)
  difference         Decimal      @default(0) @db.Decimal(12, 2)
  notes              String?
  closedAt           DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id])
  session            CashSession  @relation(fields: [sessionId], references: [id])
  closedBy           User?        @relation("CashClosingClosedBy", fields: [closedById], references: [id])

  @@index([organizationId, closedAt])
}

model Room {
  id           String        @id @default(uuid())
  gymId        String
  name         String
  capacity     Int?
  createdAt    DateTime      @default(now())
  gym          Gym           @relation(fields: [gymId], references: [id])
  appointments Appointment[]
  gymClasses   GymClass[]
}

model Appointment {
  id             String            @id @default(uuid())
  organizationId String
  gymId          String?
  roomId         String?
  memberId       String?
  professionalId String?
  title          String
  description    String?
  type           AppointmentType
  status         AppointmentStatus @default(SCHEDULED)
  startAt        DateTime
  endAt          DateTime
  capacity       Int?
  color          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id])
  gym            Gym?              @relation(fields: [gymId], references: [id])
  room           Room?             @relation(fields: [roomId], references: [id])
  member         Member?           @relation(fields: [memberId], references: [id])
  professional   User?             @relation("AppointmentProfessional", fields: [professionalId], references: [id])
}

model CheckIn {
  id             String        @id @default(uuid())
  organizationId String
  gymId          String?
  memberId       String
  method         CheckInMethod
  checkedAt      DateTime      @default(now())
  notes          String?
  organization   Organization  @relation(fields: [organizationId], references: [id])
  gym            Gym?          @relation(fields: [gymId], references: [id])
  member         Member        @relation(fields: [memberId], references: [id])
}

model MuscleGroup {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  exercises Exercise[]
}

model Exercise {
  id               String            @id @default(uuid())
  organizationId   String
  muscleGroupId    String?
  name             String
  description      String?
  videoUrl         String?
  imageUrl         String?
  equipment        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id])
  muscleGroup      MuscleGroup?      @relation(fields: [muscleGroupId], references: [id])
  workoutExercises WorkoutExercise[]
}

model Workout {
  id              String              @id @default(uuid())
  organizationId  String
  createdById     String?
  name            String
  description     String?
  goal            String?
  level           WorkoutLevel        @default(BEGINNER)
  status          WorkoutStatus       @default(DRAFT)
  durationMinutes Int?
  restSeconds     Int?
  imageUrl        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id])
  createdBy       User?               @relation("WorkoutCreator", fields: [createdById], references: [id])
  exercises       WorkoutExercise[]
  assignments     WorkoutAssignment[]
}

model WorkoutExercise {
  id          String   @id @default(uuid())
  workoutId   String
  exerciseId  String
  order       Int
  sets        Int
  reps        String
  restSeconds Int?
  notes       String?
  workout     Workout  @relation(fields: [workoutId], references: [id])
  exercise    Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([workoutId, exerciseId, order])
}

model WorkoutAssignment {
  id        String    @id @default(uuid())
  workoutId String
  memberId  String
  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  workout   Workout   @relation(fields: [workoutId], references: [id])
  member    Member    @relation(fields: [memberId], references: [id])
}

model PhysicalAssessment {
  id             String   @id @default(uuid())
  memberId       String
  weightKg       Decimal? @db.Decimal(6, 2)
  heightCm       Decimal? @db.Decimal(6, 2)
  bodyFatPercent Decimal? @db.Decimal(5, 2)
  muscleMassKg   Decimal? @db.Decimal(6, 2)
  waistCm        Decimal? @db.Decimal(6, 2)
  chestCm        Decimal? @db.Decimal(6, 2)
  hipCm          Decimal? @db.Decimal(6, 2)
  notes          String?
  assessedAt     DateTime @default(now())
  member         Member   @relation(fields: [memberId], references: [id])
}

model Product {
  id             String          @id @default(uuid())
  organizationId String
  gymId          String?
  name           String
  description    String?
  category       String
  sku            String?
  barcode        String?
  price          Decimal         @db.Decimal(12, 2)
  cost           Decimal         @default(0) @db.Decimal(12, 2)
  stock          Int             @default(0)
  minStock       Int             @default(0)
  unit           String          @default("Unidade")
  trackStock     Boolean         @default(true)
  imageUrl       String?
  label          String?
  status         ProductStatus   @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id])
  gym            Gym?            @relation(fields: [gymId], references: [id])
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
}

model StockMovement {
  id             String            @id @default(uuid())
  organizationId String
  productId      String
  type           StockMovementType
  quantity       Int
  reason         String?
  reference      String?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id])
  product        Product           @relation(fields: [productId], references: [id])
}

model Sale {
  id               String        @id @default(uuid())
  organizationId   String
  gymId            String?
  memberId         String?
  sellerId         String?
  cashSessionId    String?
  customerName     String?
  sellerName       String?
  type             SaleType      @default(NORMAL)
  status           SaleStatus    @default(COMPLETED)
  subtotal         Decimal       @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(12, 2)
  discountReason   String?
  taxAmount        Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  amountReceived   Decimal?      @db.Decimal(12, 2)
  changeAmount     Decimal       @default(0) @db.Decimal(12, 2)
  paymentReference String?
  receiptNumber    String?
  soldAt           DateTime      @default(now())
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organization     Organization  @relation(fields: [organizationId], references: [id])
  gym              Gym?          @relation(fields: [gymId], references: [id])
  member           Member?       @relation(fields: [memberId], references: [id])
  seller           User?         @relation("SaleSeller", fields: [sellerId], references: [id])
  cashSession      CashSession?  @relation(fields: [cashSessionId], references: [id])
  items            SaleItem[]
  payments         Payment[]

  @@unique([organizationId, receiptNumber])
  @@index([cashSessionId])
}

model SaleItem {
  id          String    @id @default(uuid())
  saleId      String
  productId   String?
  planId      String?
  classId     String?
  kind        String?
  productName String
  sku         String?
  quantity    Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  unitCost    Decimal?  @db.Decimal(12, 2)
  total       Decimal   @db.Decimal(12, 2)
  sale        Sale      @relation(fields: [saleId], references: [id])
  product     Product?  @relation(fields: [productId], references: [id])
  plan        Plan?     @relation(fields: [planId], references: [id])
  gymClass    GymClass? @relation(fields: [classId], references: [id])

  @@index([planId])
  @@index([classId])
}

model Employee {
  id             String         @id @default(uuid())
  organizationId String
  gymId          String?
  userId         String?        @unique
  name           String
  role           String
  department     String?
  email          String?
  phone          String?
  status         EmployeeStatus @default(ACTIVE)
  salary         Decimal?       @db.Decimal(12, 2)
  hireDate       DateTime?
  avatarUrl      String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
  gym            Gym?           @relation(fields: [gymId], references: [id])
  user           User?          @relation(fields: [userId], references: [id])
  classes        GymClass[]     @relation("ClassInstructor")
}

model GymClass {
  id              String            @id @default(uuid())
  organizationId  String
  gymId           String?
  roomId          String?
  instructorId    String?
  name            String
  category        String
  description     String?
  equipment       String?
  startAt         DateTime?
  endAt           DateTime?
  durationMinutes Int?
  capacity        Int               @default(0)
  participants    Int               @default(0)
  status          GymClassStatus    @default(SCHEDULED)
  allowWaitlist   Boolean           @default(true)
  requiresCheckIn Boolean           @default(false)
  color           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id])
  gym             Gym?              @relation(fields: [gymId], references: [id])
  room            Room?             @relation(fields: [roomId], references: [id])
  instructor      Employee?         @relation("ClassInstructor", fields: [instructorId], references: [id])
  enrollments     ClassEnrollment[]
  saleItems       SaleItem[]
}

model ClassEnrollment {
  id        String                @id @default(uuid())
  classId   String
  memberId  String
  status    ClassEnrollmentStatus @default(RESERVED)
  checkedAt DateTime?
  createdAt DateTime              @default(now())
  gymClass  GymClass              @relation(fields: [classId], references: [id])
  member    Member                @relation(fields: [memberId], references: [id])

  @@unique([classId, memberId])
}

model Message {
  id             String             @id @default(uuid())
  organizationId String
  title          String?
  content        String
  channel        MessageChannel
  status         MessageStatus      @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id])
  recipients     MessageRecipient[]
}

model MessageRecipient {
  id        String  @id @default(uuid())
  messageId String
  memberId  String
  delivered Boolean @default(false)
  opened    Boolean @default(false)
  clicked   Boolean @default(false)
  message   Message @relation(fields: [messageId], references: [id])
  member    Member  @relation(fields: [memberId], references: [id])

  @@unique([messageId, memberId])
}

model Integration {
  id             String       @id @default(uuid())
  organizationId String
  provider       String
  name           String
  isActive       Boolean      @default(false)
  config         Json?
  connectedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())
}
