generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  MANAGER
  TRAINER
  RECEPTIONIST
  FINANCE
  NUTRITIONIST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  OVERDUE
  BLOCKED
  CANCELLED
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  OVERDUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MULTICAIXA
  PIX
  DIRECT_DEBIT
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AppointmentType {
  CLASS
  PERSONAL
  ASSESSMENT
  MEETING
  EVENT
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CheckInMethod {
  QR_CODE
  MANUAL
  BIOMETRIC
  APP
  NFC
}

enum MessageChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum MessageStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED
}

enum WorkoutLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum WorkoutStatus {
  ACTIVE
  PAUSED
  DRAFT
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  NOT_INFORMED
}

model Organization {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  email         String?
  phone         String?
  website       String?
  logoUrl       String?
  country       String?        @default("Angola")
  currency      String         @default("AOA")
  timezone      String         @default("Africa/Luanda")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  gyms          Gym[]
  users         User[]
  members       Member[]
  plans         Plan[]
  subscriptions Subscription[]
  payments      Payment[]
  expenses      Expense[]
  workouts      Workout[]
  exercises     Exercise[]
  appointments  Appointment[]
  checkIns      CheckIn[]
  messages      Message[]
  integrations  Integration[]
}

model Gym {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  slug           String
  email          String?
  phone          String?
  address        String?
  city           String?
  province       String?
  country        String?       @default("Angola")
  logoUrl        String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  members        Member[]
  users          UserGym[]
  rooms          Room[]
  appointments   Appointment[]
  checkIns       CheckIn[]
}

model User {
  id              String        @id @default(uuid())
  organizationId  String
  name            String
  email           String        @unique
  phone           String?
  passwordHash    String?
  role            UserRole      @default(ADMIN)
  status          UserStatus    @default(ACTIVE)
  avatarUrl       String?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id])
  gyms            UserGym[]
  createdWorkouts Workout[]     @relation("WorkoutCreator")
  appointments    Appointment[] @relation("AppointmentProfessional")
}

model UserGym {
  id        String   @id @default(uuid())
  userId    String
  gymId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  gym       Gym      @relation(fields: [gymId], references: [id])

  @@unique([userId, gymId])
}

model Member {
  id                 String               @id @default(uuid())
  organizationId     String
  gymId              String?
  name               String
  email              String?
  phone              String?
  birthDate          DateTime?
  gender             Gender               @default(NOT_INFORMED)
  documentNumber     String?
  address            String?
  city               String?
  status             MemberStatus         @default(ACTIVE)
  avatarUrl          String?
  emergencyName      String?
  emergencyPhone     String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  organization       Organization         @relation(fields: [organizationId], references: [id])
  gym                Gym?                 @relation(fields: [gymId], references: [id])
  subscriptions      Subscription[]
  payments           Payment[]
  checkIns           CheckIn[]
  appointments       Appointment[]
  assessments        PhysicalAssessment[]
  workoutAssignments WorkoutAssignment[]
  messages           MessageRecipient[]
}

model Plan {
  id               String         @id @default(uuid())
  organizationId   String
  name             String
  description      String?
  price            Decimal        @db.Decimal(12, 2)
  durationDays     Int
  status           PlanStatus     @default(ACTIVE)
  maxCheckIns      Int?
  includesClasses  Boolean        @default(true)
  includesWorkouts Boolean        @default(false)
  isPopular        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organization     Organization   @relation(fields: [organizationId], references: [id])
  subscriptions    Subscription[]
}

model Subscription {
  id              String             @id @default(uuid())
  organizationId  String
  memberId        String
  planId          String
  status          SubscriptionStatus @default(ACTIVE)
  startDate       DateTime
  endDate         DateTime
  nextBillingDate DateTime?
  autoRenew       Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  organization    Organization       @relation(fields: [organizationId], references: [id])
  member          Member             @relation(fields: [memberId], references: [id])
  plan            Plan               @relation(fields: [planId], references: [id])
  payments        Payment[]
}

model Payment {
  id             String        @id @default(uuid())
  organizationId String
  memberId       String?
  subscriptionId String?
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  dueDate        DateTime?
  reference      String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  member         Member?       @relation(fields: [memberId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
}

model Expense {
  id             String         @id @default(uuid())
  organizationId String
  category       String
  description    String
  amount         Decimal        @db.Decimal(12, 2)
  method         PaymentMethod?
  status         PaymentStatus  @default(PAID)
  paidAt         DateTime?
  dueDate        DateTime?
  supplier       String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
}

model Room {
  id           String        @id @default(uuid())
  gymId        String
  name         String
  capacity     Int?
  createdAt    DateTime      @default(now())
  gym          Gym           @relation(fields: [gymId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id             String            @id @default(uuid())
  organizationId String
  gymId          String?
  roomId         String?
  memberId       String?
  professionalId String?
  title          String
  description    String?
  type           AppointmentType
  status         AppointmentStatus @default(SCHEDULED)
  startAt        DateTime
  endAt          DateTime
  capacity       Int?
  color          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id])
  gym            Gym?              @relation(fields: [gymId], references: [id])
  room           Room?             @relation(fields: [roomId], references: [id])
  member         Member?           @relation(fields: [memberId], references: [id])
  professional   User?             @relation("AppointmentProfessional", fields: [professionalId], references: [id])
}

model CheckIn {
  id             String        @id @default(uuid())
  organizationId String
  gymId          String?
  memberId       String
  method         CheckInMethod
  checkedAt      DateTime      @default(now())
  notes          String?
  organization   Organization  @relation(fields: [organizationId], references: [id])
  gym            Gym?          @relation(fields: [gymId], references: [id])
  member         Member        @relation(fields: [memberId], references: [id])
}

model MuscleGroup {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  exercises Exercise[]
}

model Exercise {
  id               String            @id @default(uuid())
  organizationId   String
  muscleGroupId    String?
  name             String
  description      String?
  videoUrl         String?
  imageUrl         String?
  equipment        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id])
  muscleGroup      MuscleGroup?      @relation(fields: [muscleGroupId], references: [id])
  workoutExercises WorkoutExercise[]
}

model Workout {
  id              String              @id @default(uuid())
  organizationId  String
  createdById     String?
  name            String
  description     String?
  goal            String?
  level           WorkoutLevel        @default(BEGINNER)
  status          WorkoutStatus       @default(DRAFT)
  durationMinutes Int?
  restSeconds     Int?
  imageUrl        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id])
  createdBy       User?               @relation("WorkoutCreator", fields: [createdById], references: [id])
  exercises       WorkoutExercise[]
  assignments     WorkoutAssignment[]
}

model WorkoutExercise {
  id          String   @id @default(uuid())
  workoutId   String
  exerciseId  String
  order       Int
  sets        Int
  reps        String
  restSeconds Int?
  notes       String?
  workout     Workout  @relation(fields: [workoutId], references: [id])
  exercise    Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([workoutId, exerciseId, order])
}

model WorkoutAssignment {
  id        String   @id @default(uuid())
  workoutId String
  memberId  String
  startDate DateTime @default(now())
  endDate   DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  workout   Workout  @relation(fields: [workoutId], references: [id])
  member    Member   @relation(fields: [memberId], references: [id])
}

model PhysicalAssessment {
  id             String   @id @default(uuid())
  memberId       String
  weightKg       Decimal? @db.Decimal(6, 2)
  heightCm       Decimal? @db.Decimal(6, 2)
  bodyFatPercent Decimal? @db.Decimal(5, 2)
  muscleMassKg   Decimal? @db.Decimal(6, 2)
  waistCm        Decimal? @db.Decimal(6, 2)
  chestCm        Decimal? @db.Decimal(6, 2)
  hipCm          Decimal? @db.Decimal(6, 2)
  notes          String?
  assessedAt     DateTime @default(now())
  member         Member   @relation(fields: [memberId], references: [id])
}

model Message {
  id             String             @id @default(uuid())
  organizationId String
  title          String?
  content        String
  channel        MessageChannel
  status         MessageStatus      @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id])
  recipients     MessageRecipient[]
}

model MessageRecipient {
  id        String  @id @default(uuid())
  messageId String
  memberId  String
  delivered Boolean @default(false)
  opened    Boolean @default(false)
  clicked   Boolean @default(false)
  message   Message @relation(fields: [messageId], references: [id])
  member    Member  @relation(fields: [memberId], references: [id])

  @@unique([messageId, memberId])
}

model Integration {
  id             String       @id @default(uuid())
  organizationId String
  provider       String
  name           String
  isActive       Boolean      @default(false)
  config         Json?
  connectedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())
}
