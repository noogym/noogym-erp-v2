{
  "name": "noogym",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:desktop": "turbo dev --filter=@noogym/desktop",
    "dev:web": "turbo dev --filter=@noogym/web-admin",
    "dev:noogym-erp-api": "turbo dev --filter=@noogym/noogym-erp-api",
    "localhost": "turbo dev --filter=@noogym/web-admin --filter=@noogym/noogym-erp-api",
    "cypress:open": "pnpm --filter @noogym/cypress open",
    "cypress:install": "pnpm --filter @noogym/cypress install:binary",
    "cypress:verify": "pnpm --filter @noogym/cypress verify",
    "cypress:run": "pnpm --filter @noogym/cypress test",
    "e2e": "turbo e2e",
    "build": "turbo build",
    "build:desktop": "turbo build --filter=@noogym/desktop",
    "build:web": "turbo build --filter=@noogym/web-admin",
    "docker:api:build": "docker build -f apps/noogym-erp-api/Dockerfile -t noogym-api .",
    "docker:api:run": "docker run --env-file deploy.env -p 3333:3333 noogym-api",
    "docker:web:build": "docker build -f apps/web-admin/Dockerfile -t noogym-web-admin .",
    "docker:web:run": "docker run -p 3000:3000 noogym-web-admin",
    "docker:compose:up": "docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build",
    "docker:compose:down": "docker compose -f docker-compose.yml -f docker-compose.local.yml down",
    "docker:compose:logs": "docker compose -f docker-compose.yml -f docker-compose.local.yml logs -f",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.14",
      "qs": "6.15.2"
    }
  }
}
